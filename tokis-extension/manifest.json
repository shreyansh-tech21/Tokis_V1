{
  "manifest_version": 3,
  "name": "Tokis",
  "version": "1.0",

  "permissions": ["activeTab", "storage"],

  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8003/*",
    "http://127.0.0.1:8003/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*"],
      "js": ["ui/tokisMask.js", "ui/tokisM4.js", "ui/workspacePopup.js", "content.js"],
      "css": ["style.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["ui/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
